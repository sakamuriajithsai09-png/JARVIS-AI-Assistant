# Public client configuration; the anon/publishable key is intended for browser use.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional full URL override. Defaults to {VITE_SUPABASE_URL}/functions/v1/jarvis-chat.
VITE_JARVIS_CHAT_URL=

# Server-only for local backend development. Never prefix this with VITE_.
# In Supabase, set this as an Edge Function secret instead.
GEMINI_API_KEY=
